APP_NAME=CineRadar
APP_ENV=local
APP_KEY=base64:IBxp8QO7AI3HvY2yZkw+r0PA9q0mhE5irG7A7+/fMKI=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# COMPOSE_PROFILES=db liga o serviço "db" do docker-compose.prod.yml (MySQL
# containerizado, zero pré-requisito no host). Pra usar um MySQL externo em
# vez desse, apague esta linha (ou deixe vazia) e aponte DB_HOST/DB_PORT/
# DB_USERNAME/DB_PASSWORD pro servidor real (use DB_HOST=host.docker.internal
# se ele rodar na mesma máquina, fora do Docker).
COMPOSE_PROFILES=db
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=guiadefilmes
DB_USERNAME=guiadefilmes
DB_PASSWORD=guiadefilmes

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

# phpredis (extensão nativa em C, já instalada na imagem) em vez de predis
# (biblioteca 100% PHP) — mais rápido e mais leve em CPU/memória
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_QUEUE=default

MAIL_MAILER=log
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# APIs externas (preencha com suas chaves para funcionalidades completas)
TMDB_API_KEY=
GEMINI_API_KEY=
OMDB_API_KEY=
