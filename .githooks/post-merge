#!/bin/bash
# Roda automaticamente depois de "git pull" / "git merge".
# Garante que o build do frontend e as dependências do backend sejam
# refeitos quando o código-fonte correspondente mudar.
#
# Estrutura do projeto (padrão): o app Laravel fica na RAIZ do repositório
# (composer.json, artisan, app/, database/, vendor/, .env aqui mesmo). O
# Apache aponta o DocumentRoot pra public/, onde também fica publicado o
# build estático do frontend. frontend/ é só o código-fonte do Vue.
set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

FILES_CHANGED="$(git diff --name-only HEAD@{1} HEAD 2>/dev/null || true)"

if echo "$FILES_CHANGED" | grep -q '^frontend/'; then
  echo "==> Mudanças no frontend detectadas."
  cd "$REPO_ROOT/frontend"

  if echo "$FILES_CHANGED" | grep -qE '^frontend/package(-lock)?\.json$'; then
    echo "==> package.json mudou, rodando npm install..."
    npm install
  fi

  echo "==> Rodando build do frontend..."
  npm run build
  cd "$REPO_ROOT"

  if [ -d "$REPO_ROOT/public" ]; then
    echo "==> Publicando build em public/ (DocumentRoot do Apache)..."
    # cp em vez de rsync (nem sempre instalado) — não usa --delete de propósito,
    # pra não arriscar apagar o index.php do Laravel ou o .htaccess.
    cp -rf "$REPO_ROOT/frontend/dist/." "$REPO_ROOT/public/"

    # O SpaController cacheia o HTML de cada rota (com asset hashes do build
    # antigo embutidos) por até 6h — sem isso, quem pegasse cache continuaria
    # recebendo o public/index.html anterior por até 6h após o deploy.
    echo "==> Limpando cache de HTML do SpaController (asset hashes do build antigo)..."
    php artisan cache:clear
  else
    echo "==> AVISO: pasta public/ não existe, build não foi publicado. Publique manualmente."
  fi
fi

if echo "$FILES_CHANGED" | grep -qE '^composer\.(json|lock)$'; then
  echo "==> composer.json/lock mudou, rodando composer install..."
  composer install --no-dev --optimize-autoloader
fi

if [ ! -x "$REPO_ROOT/venv/bin/python3" ]; then
  echo "==> venv Python não encontrado (scripts/justwatch.py, compress_video.py precisam dele), criando..."
  python3 -m venv "$REPO_ROOT/venv"
  "$REPO_ROOT/venv/bin/pip" install --upgrade pip
  "$REPO_ROOT/venv/bin/pip" install -r "$REPO_ROOT/scripts/requirements.txt"
elif ! "$REPO_ROOT/venv/bin/python3" -c "import simplejustwatchapi" 2>/dev/null; then
  echo "==> Dependências do venv Python faltando, reinstalando..."
  "$REPO_ROOT/venv/bin/pip" install -r "$REPO_ROOT/scripts/requirements.txt"
fi

if echo "$FILES_CHANGED" | grep -qE '^database/migrations/'; then
  echo "==> Migration nova detectada, rodando php artisan migrate --force..."
  # Limpa cache de pacotes/config antes de migrar: evita erro de classe de pacote
  # de dev (ex: nunomaduro/collision) que ficou em cache de um composer install
  # anterior sem --no-dev, mas não está instalado agora.
  rm -f bootstrap/cache/packages.php bootstrap/cache/services.php bootstrap/cache/config.php
  php artisan migrate --force
fi

echo "==> post-merge hook concluído."
