#!/bin/bash
# Roda automaticamente depois de "git pull" / "git merge".
# Garante que o build do frontend e as dependências do backend sejam
# refeitos quando o código-fonte correspondente mudar.
#
# Estrutura do projeto (padrão): backend/ é o app Laravel completo, com seu
# próprio vendor/ e .env. O Apache aponta o DocumentRoot pra backend/public,
# onde também fica publicado o build estático do frontend.
set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

FILES_CHANGED="$(git diff --name-only HEAD@{1} HEAD 2>/dev/null || true)"

if echo "$FILES_CHANGED" | grep -q '^frontend/'; then
  echo "==> Mudanças no frontend detectadas."
  cd "$REPO_ROOT/frontend"

  if echo "$FILES_CHANGED" | grep -qE '^frontend/package(-lock)?\.json$'; then
    echo "==> package.json mudou, rodando npm install..."
    npm install
  fi

  echo "==> Rodando build do frontend..."
  npm run build
  cd "$REPO_ROOT"

  if [ -d "$REPO_ROOT/backend/public" ]; then
    echo "==> Publicando build em backend/public (DocumentRoot do Apache)..."
    # cp em vez de rsync (nem sempre instalado) — não usa --delete de propósito,
    # pra não arriscar apagar o index.php do Laravel ou o .htaccess.
    cp -rf "$REPO_ROOT/frontend/dist/." "$REPO_ROOT/backend/public/"
  else
    echo "==> AVISO: pasta backend/public não existe, build não foi publicado. Publique manualmente."
  fi
fi

if echo "$FILES_CHANGED" | grep -qE '^backend/composer\.(json|lock)$'; then
  echo "==> composer.json/lock mudou, rodando composer install..."
  cd "$REPO_ROOT/backend"
  composer install --no-dev --optimize-autoloader
  cd "$REPO_ROOT"
fi

if echo "$FILES_CHANGED" | grep -qE '^backend/database/migrations/'; then
  echo "==> AVISO: migration nova detectada. Rode manualmente:"
  echo "    cd backend && php artisan migrate --force"
fi

echo "==> post-merge hook concluído."
